# Never commit captured browser traffic — it can contain live session
# tokens, account identifiers, or other credentials.
*.har

# Python
__pycache__/
*.pyc
.pytest_cache/

# Local-only test artifacts (throwaway Docker HA instance tokens, never
# real RENAC credentials, but no reason to keep them either)
.ha_test_token

# Home Assistant runtime state generated by docker-compose.test.yml --
# only docker/ha_config/configuration.yaml is meant to be tracked.
docker/ha_config/*
!docker/ha_config/configuration.yaml

# Same for the live-account test instance (docker-compose.live.yml).
# CRITICAL: .storage/core.config_entries under here contains real RENAC
# credentials in plaintext once a config entry is created -- never track
# anything in this directory except the authored configuration.yaml.
docker/ha_config_live/*
!docker/ha_config_live/configuration.yaml


# OS / editor cruft
.DS_Store
Thumbs.db

# Local tooling metadata, not part of the deliverable
.megamemory/


# Same for the clean HACS-screenshot instance (docker-compose.clean.yml).
docker/ha_config_clean/*
!docker/ha_config_clean/configuration.yaml
